<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- 添加魅惑菇转化手术到人类的可用手术列表 -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Human"]/recipes</xpath>
    <value>
      <li>RKU_AllurecapConversion</li>
    </value>
  </Operation>

  <!-- 添加魅惑菇转化手术到动物的可用手术列表 -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[@Name="AnimalThingBase"]/recipes</xpath>
    <value>
      <li>RKU_AllurecapConversion</li>
    </value>
  </Operation>

</Patch>
