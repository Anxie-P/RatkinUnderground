    <category>Misc</category>
    <targetTags>
      <li>Caravan</li>
    </targetTags>
    <workerClass>RatkinUnderground.RKU_IncidentWorker_BuildMap</workerClass>
	<letterLabel>钻机遭遇：地下湖</letterLabel>
