  <IncidentDef>
    <defName>RKU_FinalBattle</defName>
    <label>血战</label>
    <category>ThreatBig</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>IncidentWorker_MakeGameCondition</workerClass>
    <letterLabel>终末血战</letterLabel>
    <letterText>游击队集结了本地全部的精锐，对殖民地发动了最终的决战，每4小时会根据殖民地状态分配不同强度的袭击，总共6波。</letterText>
    <letterDef>ThreatBig</letterDef>
    <gameCondition>RKU_FinalBattle</gameCondition>
    <durationDays>30</durationDays>
    <baseChance>0</baseChance>
  </IncidentDef>

  <IncidentDef>
    <defName>RKU_LimitedFleshbeastAttack</defName>
    <label>地震：血肉兽</label>
    <workerClass>RatkinUnderground.IncidentWorker_LimitedFleshbeastAttack</workerClass>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <category>ThreatBig</category>
    <pointsScaleable>true</pointsScaleable>
    <baseChance>0</baseChance>
    <letterLabel>地震：血肉兽</letterLabel>
    <letterText>撼地装置导致的地震惊醒了血肉兽，它们正从地下涌出来！</letterText>
    <letterTextPlural>Several sinkholes have started appearing. The sounds of writhing flesh and cracking bones can be heard from below.</letterTextPlural>
    <letterDef>ThreatBig</letterDef>
    <earliestDay>0</earliestDay>
  </IncidentDef>

