<Defs>
  <IncidentDef>
    <defName>RKU_IncidentWorker_FinalRaid</defName>
    <label>终末血战</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>RatkinUnderground.RKU_IncidentWorker_FinalRaid</workerClass>
    <baseChance>0</baseChance>
    <category>ThreatBig</category>
    <pointsScaleable>true</pointsScaleable>
    <tale>Raid</tale>
    <ignoreRecentSelectionWeighting>true</ignoreRecentSelectionWeighting>
  </IncidentDef>

  <IncidentDef>
    <defName>RKU_RatkinTunnel_Fir</defName>
    <label>鼠族隧道游击队</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>RatkinUnderground.RKU_IncidentWorker_Guerrillas</workerClass>
    <letterLabel>鼠族隧道游击队</letterLabel>
    <letterText>侦测到地下活动，一支鼠族地下游击队正在进攻殖民地。</letterText>
    <letterDef>ThreatBig</letterDef>
    <baseChance>0</baseChance>
    <minRefireDays>10</minRefireDays>
    <category>ThreatBig</category>
    <pointsScaleable>true</pointsScaleable>
    <minThreatPoints>500</minThreatPoints>
    <tale>Raid</tale>
  </IncidentDef>

  <IncidentDef>
    <defName>RKU_Incident_CaravanHijack</defName>
    <label>游击队物资劫持</label>
    <category>Misc</category>
    <pointsScaleable>true</pointsScaleable>
    <minThreatPoints>1500</minThreatPoints>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>RatkinUnderground.RKU_IncidentWorker_CaravanHijack</workerClass>
    <letterLabel>游击队物资劫持</letterLabel>
    <letterText>游击队侦察到你的基地里有鼠族王国的一支由贵族带领的商队。他们决定趁机发动突袭，劫持这些珍贵的物资。如果你不予阻止，会得到游击队员们的感谢。</letterText>
    <baseChance>4</baseChance>
    <minRefireDays>30</minRefireDays>
  </IncidentDef>

  <IncidentDef>
    <defName>RKU_RatkinTunnel_Thi</defName>
    <label>？？？</label>
