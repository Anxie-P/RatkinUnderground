  <RatkinUnderground.RKU_DialogueEventDef>
    <defName>RKU_Relation_Warning_Serious</defName>
    <dialogueText>      我警告过你们，但你们还是去把我们的村子毁了！
他们只是平民而已，你们和那些地主军阀有什么区别？我们会反抗，这些血债必须被偿还！
（注：敌对状态下杀死游击队成员不会减少派系关系，有害手术或其他行为可以）</dialogueText>
    <priority>20</priority>
    <triggerOnStartup>true</triggerOnStartup>
    <triggerOnce>true</triggerOnce>
    <conditions>
      <li Class="RatkinUnderground.DialogueCondition_RelationshipGrade">
        <minGrade>-50</minGrade>
        <maxGrade>-50</maxGrade>
      </li>
    </conditions>
    <actions>
      <li Class="RatkinUnderground.DialogueAction_ChangeFactionRelationRange">
        <max>-50</max>
        <min>-75</min>
      </li>
    </actions>
  </RatkinUnderground.RKU_DialogueEventDef>

  <RatkinUnderground.RKU_DialogueEventDef>
    <defName>RKU_Relation_Warning_Critical</defName>
    <dialogueText>      该死的军阀！没人性的畜生！等着被炸上天吧！我们会包围你们，
把你们杀个片甲不留！</dialogueText>
    <priority>20</priority>
    <triggerOnStartup>true</triggerOnStartup>
    <triggerOnce>true</triggerOnce>
    <conditions>
