		<defName>RKU_StartupEventEnemyFifC</defName>
		<dialogueText>      就算是为了生存，也不是你们可以做出那种事的理由。</dialogueText>
		<triggerOnStartup>true</triggerOnStartup>
		<conditions>
			<li Class="RatkinUnderground.DialogueCondition_RelationshipGrade">
				<minGrade>-25</minGrade>
				<maxGrade>-1</maxGrade>
			</li>
		</conditions>
	</RatkinUnderground.RKU_DialogueEventDef>
	
	<RatkinUnderground.RKU_DialogueEventDef>
		<defName>RKU_StartupEventEnemyFifD</defName>
