	<RatkinUnderground.RKU_DialogueEventDef>
		<defName>RKU_StartupEventEnemyFif</defName>
		<dialogueText>      我们会看住你们的一举一动。</dialogueText>
		<triggerOnStartup>true</triggerOnStartup>
		<conditions>
			<li Class="RatkinUnderground.DialogueCondition_RelationshipGrade">
				<minGrade>-25</minGrade>
				<maxGrade>-1</maxGrade>
			</li>
		</conditions>
	</RatkinUnderground.RKU_DialogueEventDef>
	
	<RatkinUnderground.RKU_DialogueEventDef>
		<defName>RKU_StartupEventEnemyFifA</defName>
		<dialogueText>      我们之间的事情还有得谈，希望你方能够有个合理的解释。</dialogueText>
		<triggerOnStartup>true</triggerOnStartup>
		<conditions>
			<li Class="RatkinUnderground.DialogueCondition_RelationshipGrade">
				<minGrade>-25</minGrade>
				<maxGrade>-1</maxGrade>
			</li>
		</conditions>
	</RatkinUnderground.RKU_DialogueEventDef>
	
	<RatkinUnderground.RKU_DialogueEventDef>
		<defName>RKU_StartupEventEnemyFifB</defName>
		<dialogueText>      不要把我们当成什么可以一脚踩死的弱小派系，我们会用事实证明。</dialogueText>
		<triggerOnStartup>true</triggerOnStartup>
		<conditions>
			<li Class="RatkinUnderground.DialogueCondition_RelationshipGrade">
				<minGrade>-25</minGrade>
				<maxGrade>-1</maxGrade>
			</li>
		</conditions>
	</RatkinUnderground.RKU_DialogueEventDef>
	
