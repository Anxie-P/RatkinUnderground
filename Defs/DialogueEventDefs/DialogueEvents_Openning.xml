	<RatkinUnderground.RKU_DialogueEventDef>
		<defName>RKU_StartupEventSec</defName>
		<dialogueText>      游击队随时待命。</dialogueText>
		<triggerOnStartup>true</triggerOnStartup>
		<conditions>
			<li Class="RatkinUnderground.DialogueCondition_RelationshipGrade">
				<minGrade>50</minGrade>
