<?xml version="1.0" encoding="utf-8" ?>
<Defs>
   <!-- 地鼠幸存者 -->
  <QuestScriptDef>
		<defName>RKU_GuerrillaSurvivor</defName>
		<defaultHidden>false</defaultHidden>
		<isRootSpecial>true</isRootSpecial>
		<rootSelectionWeight>1</rootSelectionWeight>
    <autoAccept>true</autoAccept>
		<questNameRules>
			<rulesStrings>
			<li>RKU_GuerrillaSurvivorName1</li>
			<li>RKU_GuerrillaSurvivorName2</li>
			<li>RKU_GuerrillaSurvivorName3</li>
			<li>RKU_GuerrillaSurvivorName4</li>
			<li>RKU_GuerrillaSurvivorName5</li>
			</rulesStrings>
		</questNameRules>
		<questDescriptionRules>
			<rulesStrings>
			<li>RKU_GuerrillaSurvivorDesc1</li>
			</rulesStrings>
		</questDescriptionRules>
		<root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_GetMap" />
        <li Class="RatkinUnderground.QuestNode_RequireFactionGoodwill">
          <faction>RKU_Faction</faction>
          <minGoodwill>-24</minGoodwill>
        </li>
        <li Class="QuestNode_GetSiteTile">
          <storeAs>siteTile</storeAs>
          <preferCloserTiles>true</preferCloserTiles>
        </li>

        <li Class="RatkinUnderground.QuestNode_RKU_GetFactionByDef">
					 <storeAs>askerFaction</storeAs>
					 <requiredFactionDefs>
					 <li>RKU_Faction</li>
					 </requiredFactionDefs>
					 <allowPermanentEnemy>false</allowPermanentEnemy>
				</li>
				<li Class="RatkinUnderground.QuestNode_RKU_GetPawnByFactionDef">
					 <storeAs>asker</storeAs>
					 <requiredFactionDefs>
						<li>RKU_Faction</li>
					 </requiredFactionDefs>
					 <mustBeFactionLeader>true</mustBeFactionLeader>
					 <allowPermanentEnemyFaction>true</allowPermanentEnemyFaction>
				</li>

        <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
          <storeAs>sitePartDefs</storeAs>
          <storeFactionAs>siteFaction</storeFactionAs>
          <sitePartsTags>
            <li><tag>GuerrillaSurvivor</tag></li>
          </sitePartsTags>
        </li>

        <li Class="QuestNode_GetDefaultSitePartsParams">
					<tile>$siteTile</tile>
					<faction>$siteFaction</faction>
					<sitePartDefs>$sitePartDefs</sitePartDefs>
					<storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
				</li>

        <li Class="QuestNode_SubScript">
          <def>Util_GenerateSite</def>
          <parms>
            <hiddenSitePartsPossible>true</hiddenSitePartsPossible>
          </parms>
        </li>

        <li Class="QuestNode_SpawnWorldObjects">
          <worldObjects>$site</worldObjects>
          <defsToExcludeFromHyperlinks>Human</defsToExcludeFromHyperlinks>
        </li>

        <li Class="QuestNode_GetSiteThreatPoints">
					<storeAs>sitePoints</storeAs>
					<sitePartsParams>$sitePartsParams</sitePartsParams>
				</li>
				<li Class="QuestNode_SubScript">
					<def>Util_GetDefaultRewardValueFromPoints</def>
					<parms>
						<points>$sitePoints</points>
					</parms>
				</li>

        <li Class="QuestNode_WorldObjectTimeout">
        <worldObject>$site</worldObject>
        <isQuestTimeout>true</isQuestTimeout>
        <delayTicks>$(randInt(8,20)*60000)</delayTicks>
        <inSignalDisable>site.MapGenerated</inSignalDisable>
        <node Class="QuestNode_End">
          <outcome>Fail</outcome>
          <sendStandardLetter>true</sendStandardLetter>
        </node>
        </li>

        <li Class="RatkinUnderground.QuestNode_SurvivorDead">
          <pawn>$guerrilla</pawn>
          <!-- <node Class="QuestNode_End">
          </node> -->
        </li>

        <li Class="QuestNode_AddPawnReward">
          <pawn>$guerrilla</pawn>
          <inSignalChoiceUsed>site.MapGenerated</inSignalChoiceUsed>
          <rewardDetailsHidden>true</rewardDetailsHidden>
        </li>

        <li Class="QuestNode_NoWorldObject">
          <worldObject>$site</worldObject>
          <node Class="QuestNode_End" />
        </li>
      </nodes>
		</root>
	</QuestScriptDef>

  <SitePartDef>
    <defName>GuerrillaSurvivor</defName>
    <label>Guerrilla Survivor</label>
    <description>游击队幸存者</description>
    <workerClass>RatkinUnderground.SitePartWorker_GuerrillaSurvivor</workerClass>
    <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/DownedRefugee</expandingIconTexture>
    <forceExitAndRemoveMapCountdownDurationDays>6</forceExitAndRemoveMapCountdownDurationDays>
    <requiresFaction>true</requiresFaction>
    <increasesPopulation>true</increasesPopulation>
    <handlesWorldObjectTimeoutInspectString>true</handlesWorldObjectTimeoutInspectString>
    <tags>
      <li>GuerrillaSurvivor</li>
    </tags>
  </SitePartDef>

  <GenStepDef>
    <defName>GuerrillaSurvivor</defName>
    <linkWithSite>GuerrillaSurvivor</linkWithSite>
    <order>460</order>
    <genStep Class="RatkinUnderground.RKU_GenStep_GuerrillaSurvivor">
    </genStep>
  </GenStepDef>
</Defs>
