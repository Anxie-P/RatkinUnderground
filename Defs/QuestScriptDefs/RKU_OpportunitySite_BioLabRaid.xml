<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 王国生化研究所突袭任务 -->
  <QuestScriptDef>
    <defName>RKU_OpportunitySite_BioLabRaid</defName>
    <rootSelectionWeight>0.1</rootSelectionWeight>
    <rootMinPoints>800</rootMinPoints>
    <canGiveRoyalFavor>false</canGiveRoyalFavor>
    <expireDaysRange>6~10</expireDaysRange>
    <successHistoryEvent MayRequire="Ludeon.RimWorld.Ideology">Raided_BanditCamp</successHistoryEvent>
    <questNameRules>
      <rulesStrings>
        <li>questName->The [ratkin] [lab]</li>
        <li>questName->[ratkin] [lab] [raid]</li>
        <li>questName->[asker_nameDef] and the [lab]</li>
        <li>lab->Bio-Lab</li>
        <li>lab->Research Facility</li>
        <li>lab->Biological Institute</li>
        <li>raid->Raid</li>
        <li>raid->Assault</li>
        <li>raid->Strike</li>
        <li>ratkin->Ratkin</li>
        <li>ratkin->Kingdom</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->[asker_nameFull], [asker_faction_leaderTitle] of [asker_faction_name], has sent us urgent intelligence. Apparently, a secret biological research facility operated by the Ratkin Kingdom has been discovered. The facility contains dangerous experimental weapons and biological agents that threaten all underground inhabitants. [asker_nameDef] is asking us to destroy the facility, which means eliminating all enemies and destroying the research equipment. [sitePart0_description].</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_SubScript">
          <def>Util_RandomizePointsChallengeRating</def>
          <parms>
            <pointsFactorTwoStar>1.5</pointsFactorTwoStar>
            <pointsFactorThreeStar>2</pointsFactorThreeStar>
          </parms>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_AdjustPointsForDistantFight</def>
        </li>
        <li Class="QuestNode_GetMap" />

        <li Class="RatkinUnderground.QuestNode_RequireFactionGoodwill">
          <faction>RKU_Faction</faction>
          <minGoodwill>50</minGoodwill>
        </li>

        <li Class="RatkinUnderground.QuestNode_RKU_CheckOnceEvent">
          <eventKey>RKU_GuerrillaSecretProtection_Completed</eventKey>
          <invert>false</invert>
        </li>

        <li Class="RatkinUnderground.QuestNode_RKU_GetFactionByDef">
          <storeAs>askerFaction</storeAs>
          <requiredFactionDefs>
            <li>RKU_Faction</li>
          </requiredFactionDefs>
          <allowPermanentEnemy>true</allowPermanentEnemy>
        </li>
        <li Class="RatkinUnderground.QuestNode_RKU_GetPawnByFactionDef">
          <storeAs>asker</storeAs>
          <requiredFactionDefs>
            <li>RKU_Faction</li>
          </requiredFactionDefs>
          <mustBeFactionLeader>true</mustBeFactionLeader>
          <allowPermanentEnemyFaction>true</allowPermanentEnemyFaction>
        </li>

        <li Class="QuestNode_GetSiteTile">
          <storeAs>siteTile</storeAs>
          <preferCloserTiles>true</preferCloserTiles>
        </li>
        <li Class="RatkinUnderground.QuestNode_RKU_GetFactionByDef">
          <storeAs>enemyFaction</storeAs>
          <allowNeutral>true</allowNeutral>
          <requiredFactionDefs>
            <li>Rakinia</li>
          </requiredFactionDefs>
          <allowPermanentEnemy>true</allowPermanentEnemy>
        </li>
        <li Class="RatkinUnderground.QuestNode_RKU_GetSitePartDefsByTagsAndFaction">
          <storeAs>sitePartDefs</storeAs>
          <storeFactionAs>siteFaction</storeFactionAs>
          <sitePartsTags>
            <li>
              <tag>RatkinBioLab</tag>
            </li>
          </sitePartsTags>
        </li>

        <li Class="QuestNode_GetDefaultSitePartsParams">
          <tile>$siteTile</tile>
          <faction>$siteFaction</faction>
          <sitePartDefs>$sitePartDefs</sitePartDefs>
          <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
        </li>

        <li Class="QuestNode_GetSiteThreatPoints">
          <storeAs>sitePoints</storeAs>
          <sitePartsParams>$sitePartsParams</sitePartsParams>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_GetDefaultRewardValueFromPoints</def>
          <parms>
            <points>$sitePoints</points>
          </parms>
        </li>

        <li Class="QuestNode_Multiply">
          <value1>$rewardValue</value1>
          <value2>2.0</value2>
          <storeAs>rewardValue</storeAs>
        </li>

        <li Class="QuestNode_SubScript">
          <def>Util_GenerateSite</def>
        </li>

        <li Class="QuestNode_SpawnWorldObjects">
          <worldObjects>$site</worldObjects>
        </li>

        <li Class="QuestNode_WorldObjectTimeout">
          <worldObject>$site</worldObject>
          <isQuestTimeout>true</isQuestTimeout>
          <delayTicks>$(randInt(16,32)*60000)</delayTicks>
          <inSignalDisable>site.MapGenerated</inSignalDisable>
          <destroyOnCleanup>true</destroyOnCleanup>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label TKey="LetterLabelQuestExpired">Quest expired: [resolvedQuestName]</label>
                <text TKey="LetterTextQuestExpired">The biological research facility has been abandoned. The quest [resolvedQuestName] has expired.</text>
              </li>
              <li Class="QuestNode_End">
                <outcome>Fail</outcome>
              </li>
            </nodes>
          </node>
        </li>

        <li Class="QuestNode_Signal">
          <inSignal>site.Destroyed</inSignal>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label TKey="LetterLabelQuestFailed">Quest failed: [resolvedQuestName]</label>
                <text TKey="LetterTextQuestFailed">After being discovered, the biological research facility has been evacuated. The quest [resolvedQuestName] has ended.</text>
              </li>
              <li Class="QuestNode_End">
                <outcome>Fail</outcome>
              </li>
            </nodes>
          </node>
        </li>

        <li Class="QuestNode_Signal">
          <inSignal>site.AllEnemiesDefeated</inSignal>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Notify_PlayerRaidedSomeone">
                <getRaidersFromMapParent>$site</getRaidersFromMapParent>
              </li>
              <li Class="QuestNode_GiveRewards">
                <parms>
                  <allowGoodwill>true</allowGoodwill>
                  <allowRoyalFavor>true</allowRoyalFavor>
                  <chosenPawnSignal>ChosenPawnForReward</chosenPawnSignal>
                </parms>
                <addCampLootReward>true</addCampLootReward>
                <customLetterLabel TKey="LetterLabelPaymentArrived">Payment arrived</customLetterLabel>
                <customLetterText TKey="LetterTextPaymentArrived">You have successfully destroyed the biological research facility!\n\nThe payment from the guerrillas has arrived.</customLetterText>
                <nodeIfChosenPawnSignalUsed Class="QuestNode_Letter">
                  <letterDef>ChoosePawn</letterDef>
                  <label TKey="LetterLabelFavorReceiver">[asker_faction_royalFavorLabel]</label>
                  <text TKey="LetterTextFavorReceiver">These colonists participated in the victory for the quest [resolvedQuestName]. [asker_definite] wants to know who should receive the guerrilla commendation for this service.</text>
                  <useColonistsOnMap>$site</useColonistsOnMap>
                  <chosenPawnSignal>ChosenPawnForReward</chosenPawnSignal>
                </nodeIfChosenPawnSignalUsed>
              </li>
            </nodes>
          </node>
        </li>
        <li Class="QuestNode_End">
          <inSignal>site.AllEnemiesDefeated</inSignal>
          <outcome>Success</outcome>
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

  <SitePartDef ParentName="Outpost">
    <defName>RatkinBioLab</defName>
    <label>biological research facility</label>
    <description>A secret biological research facility operated by the Ratkin Kingdom.</description>
    <showFactionInInspectString>false</showFactionInInspectString>
    <applyFactionColorToSiteTexture>false</applyFactionColorToSiteTexture>
    <tags Inherit="False">
      <li>RatkinBioLab</li>
    </tags>
    <workerClass>RatkinUnderground.SitePartWorker_RatkinBioLab</workerClass>
  </SitePartDef>

  <GenStepDef>
    <defName>RatkinBioLab</defName>
    <linkWithSite>RatkinBioLab</linkWithSite>
    <order>450</order>
    <genStep Class="RatkinUnderground.RKU_GenStep_BioLab">
      <layoutFilePath>CompoundLayouts.xml</layoutFilePath>
      <generateLoot>true</generateLoot>
      <unfogged>true</unfogged>
    </genStep>
  </GenStepDef>
</Defs>
