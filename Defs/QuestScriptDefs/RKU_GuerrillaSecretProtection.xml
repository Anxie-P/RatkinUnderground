<?xml version="1.0" encoding="utf-8"?>
<Defs>
   <!-- 地鼠机密保护 -->
  <QuestScriptDef>
    <defName>RKU_GuerrillaSecretProtection</defName>
    <defaultChallengeRating>2</defaultChallengeRating>
    <expireDaysRange>3</expireDaysRange>
    <isRootSpecial>true</isRootSpecial>
    <defaultCharity>false</defaultCharity>
    <questNameRules>
      <rulesStrings>
        <li>questName->[adjSecret] [guerrillaTitle]</li>

        <!-- Pieces -->
        <li>adjSecret->classified</li>
        <li>adjSecret->secret</li>
        <li>adjSecret->confidential</li>
        <li>adjSecret->hidden</li>

        <li>guerrillaTitle->guerrilla operative</li>
        <li>guerrillaTitle->partisan agent</li>
        <li>guerrillaTitle->underground courier</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <include>
        <li>QuestHospitalityCommon</li>
      </include>
      <rulesStrings>
        <li>questDescription->一名鼠族游击队信使携带着关于某些王国罪证的关键情报抵达殖民地。 你需要在殖民地保护她进行8小时的情报传输。在此期间，敌对势力可能会试图杀死这名信使。预计会有两次攻击即将到来。</li>
      </rulesStrings>
    </questDescriptionRules>

    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_GetMap" />
        <li Class="QuestNode_GetWalkInSpot" /> 
        <!-- 检查好感度>50 -->
        <li Class="RatkinUnderground.QuestNode_RequireFactionGoodwill">
          <faction>RKU_Faction</faction>
          <minGoodwill>50</minGoodwill>
        </li>

        <!-- 检查是否已经完成过 -->
        <li Class="RatkinUnderground.QuestNode_RKU_CheckOnceEvent">
          <eventKey>RKU_GuerrillaSecretProtection_Completed</eventKey>
          <invert>true</invert>
        </li>

        <!-- 生成信使 -->
        <li Class="QuestNode_GeneratePawn">
          <kindDef>RKU_EliteInvader</kindDef>
          <storeAs>asker</storeAs>
          <faction>RKU_Faction</faction>
          <allowPregnant>false</allowPregnant>
        </li>
        <li Class="QuestNode_PawnsArrive">
          <pawns>$asker</pawns>
          <joinPlayer>true</joinPlayer>
        </li>

        <!-- 信使离开 -->
        <li Class="QuestNode_LeaveOnCleanup">
          <pawns>$asker</pawns>
          <sendStandardLetter>false</sendStandardLetter>
          <inSignalRemovePawn>asker.RanWild</inSignalRemovePawn> 
        </li>

        <!-- 信使不会随机崩溃 -->
        <li Class="QuestNode_DisableRandomMoodCausedMentalBreaks">
          <pawns>$asker</pawns>
        </li>

        <!-- 第一次攻击波次，2小时后 -->
        <li Class="QuestNode_Delay">
          <delayTicks>5000</delayTicks> 
            <node Class="QuestNode_Sequence">
              <nodes>
                <li Class="RatkinUnderground.QuestNode_GetRandomHostileFaction">
                  <storeAs>enemyFaction</storeAs>
                </li>
                <li Class="QuestNode_SubScript">
                    <def>Util_Raid</def>
					<prefix>raid</prefix>
					<parms> 
					<inSignal>$inSignal</inSignal>
					<map>$map</map>
					<points>$points</points>
					<enemyFaction>$enemyFaction</enemyFaction>
					<walkInSpot>$walkInSpot</walkInSpot>
                    <customLetterLabel>Interception force approaching</customLetterLabel>
                    <customLetterText>Hostile forces are approaching [map_definite] to intercept the guerrilla operative!</customLetterText>
                  </parms>
                </li>
              </nodes>
            </node>
        </li>

        <!-- 第一次攻击波次，5小时后 -->
        <li Class="QuestNode_Delay">
          <delayTicks>12500</delayTicks>
            <node Class="QuestNode_Sequence">
              <nodes>
                <li Class="RatkinUnderground.QuestNode_GetRandomHostileFaction">
                  <storeAs>enemyFaction</storeAs>
                </li>
                <li Class="QuestNode_SubScript">
                    <def>Util_Raid</def>
					<prefix>raid</prefix>
					<parms>
					<inSignal>$inSignal</inSignal>
					<map>$map</map>
					<points>$points</points>
					<enemyFaction>$enemyFaction</enemyFaction> 
					<walkInSpot>$walkInSpot</walkInSpot>
                    <customLetterLabel>Second interception force</customLetterLabel>
                    <customLetterText>Another hostile force has been detected approaching [map_definite]!</customLetterText>
                  </parms>
                </li>
              </nodes>
            </node>
        </li>

        <!-- Operative departs on foot after 8 hours -->
        <li Class="QuestNode_Delay">
          <delayTicks>20000</delayTicks> <!-- 8 hours total -->
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="RatkinUnderground.QuestNode_PawnLeaveMap">
                <pawns>$asker</pawns>
                <sendStandardLetter>false</sendStandardLetter>
              </li>
              <li Class="QuestNode_InspectString">
                <targets>$asker</targets>
                <inspectString>Departing on foot</inspectString>
              </li>
              <li Class="QuestNode_Letter">
                <label>Mission completed</label>
                <text>The guerrilla operative has successfully completed the transmission and departed on foot. Before leaving, [asker_pronoun] revealed that the intelligence concerns certain kingdoms' war crimes and atrocities committed against the ratkin people.</text>
              </li>
			  <li Class="QuestNode_End">
                <outcome>Success</outcome>
                <sendStandardLetter>true</sendStandardLetter>
              </li>
            </nodes>
          </node>
        </li>

        <!-- Home faction -->
        <li Class="QuestNode_ExtraFaction">
          <pawns>$asker</pawns>
          <factionType>HomeFaction</factionType>
          <faction>RKU_Faction</faction>
          <inSignalsRemovePawn>
            <li>lodgers.RanWild</li>
            <li>lodgers.BecameMutant</li>
          </inSignalsRemovePawn>
        </li>

        <li Class="QuestNode_SetAllApparelLocked">
          <pawns>$asker</pawns>
        </li>

        <!-- - - - - - - -  -->
        <!-- End conditions -->
        <!-- - - - - - - -  -->

        <!-- Asker died -->
        <li Class="QuestNode_Signal">
          <inSignal>asker.Destroyed</inSignal>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label>Guerrilla operative killed</label>
                <letterDef>NegativeEvent</letterDef>
                <text>The guerrilla operative carrying critical intelligence has been killed. The valuable information has been lost.</text>
              </li>
              <li Class="QuestNode_End">
                <outcome>Fail</outcome>
                <goodwillChangeAmount>-10</goodwillChangeAmount>
                <goodwillChangeFactionOf>$asker</goodwillChangeFactionOf>
                <goodwillChangeReason>QuestPawnLost</goodwillChangeReason>
              </li>
            </nodes>
          </node>
        </li>

        <li Class="QuestNode_Signal">
          <inSignal>asker.SurgeryViolation</inSignal>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label>Unauthorized surgery: {SUBJECT_definite}</label>
                <letterDef>NegativeEvent</letterDef>
                <text>Unauthorized surgery has been performed on the guerrilla operative. The mission has been compromised.</text>
              </li>
              <li Class="QuestNode_End">
                <outcome>Fail</outcome>
                <goodwillChangeAmount>-15</goodwillChangeAmount>
                <goodwillChangeFactionOf>$asker</goodwillChangeFactionOf>
                <goodwillChangeReason>PerformedHarmfulSurgery</goodwillChangeReason>
              </li>
            </nodes>
          </node>
        </li>

        <li Class="QuestNode_Signal">
          <inSignal>asker.Arrested</inSignal>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label>Operative arrested</label>
                <letterDef>NegativeEvent</letterDef>
                <text>The guerrilla operative has been arrested. The intelligence has been compromised.</text>
              </li>
              <li Class="QuestNode_End">
                <outcome>Fail</outcome>
                <goodwillChangeAmount>-15</goodwillChangeAmount>
                <goodwillChangeFactionOf>$asker</goodwillChangeFactionOf>
                <goodwillChangeReason>QuestPawnArrested</goodwillChangeReason>
              </li>
            </nodes>
          </node>
        </li>

        <li Class="QuestNode_Signal">
          <inSignal>asker.LeftMap</inSignal>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="RatkinUnderground.QuestNode_RKU_RecordOnceEvent">
                <eventKey>RKU_GuerrillaSecretProtection_Completed</eventKey>
              </li>
              <li Class="QuestNode_End">
                <outcome>Success</outcome>
                <sendStandardLetter>true</sendStandardLetter>
              </li>
            </nodes>
          </node>
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

</Defs>
