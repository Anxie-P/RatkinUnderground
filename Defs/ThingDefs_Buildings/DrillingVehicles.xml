<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>RKU_DrillingVehicle</defName>
    <thingClass>RatkinUnderground.RKU_DrillingVehicle</thingClass>
    <tickerType>Normal</tickerType>
    <label>Ratkin Drilling Vehicle</label>
    <description>Ratkin Drilling Vehicle, Dig into the future</description>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <fillPercent>0.20</fillPercent>
    <pathCost>14</pathCost>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <size>(2,1)</size>
    <uiIconScale>0.6</uiIconScale>
	<building>
		<expandHomeArea>false</expandHomeArea>
    </building>
    <graphicData>
      <drawSize>(4.5,4.5)</drawSize>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Buildings/DrillingVehicle/BaseDrillingVehicle</texPath>
    </graphicData>
    <costList>
      <Steel>100</Steel>
      <ComponentIndustrial>25</ComponentIndustrial>
      <Chemfuel>50</Chemfuel>
    </costList>
    <designationCategory>Misc</designationCategory>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>RKU_DrillingVehicleCargo</defName>
    <thingClass>RatkinUnderground.RKU_DrillingVehicleCargo</thingClass>
    <tickerType>Normal</tickerType>
    <label>Cargo Drilling Vehicle</label>
    <description>A drilling vehicle specialized for transporting cargo, equipped with a large cargo bay but can only accommodate 2 passengers.</description>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <fillPercent>0.25</fillPercent>
    <pathCost>16</pathCost>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <size>(2,1)</size>
    <uiIconScale>0.6</uiIconScale>
	<building>
		<expandHomeArea>false</expandHomeArea>
    </building>
    <comps>
      <li Class="CompProperties_Transporter">
        <massCapacity>1000</massCapacity>
        <restEffectiveness>0.8</restEffectiveness>
        <showOverallStats>true</showOverallStats>
      </li>
    </comps>
    <graphicData>
      <drawSize>(4.5,4.5)</drawSize>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Buildings/DrillingVehicle/DrillingVehicleCargo</texPath>
    </graphicData>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>30</ComponentIndustrial>
      <Chemfuel>75</Chemfuel>
      <Cloth>50</Cloth>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <researchPrerequisites>
      <li>RKU_UndergroundGuerrillaEquipments</li>
    </researchPrerequisites>
    <designationCategory>Misc</designationCategory>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <Flammability>0</Flammability>
      <Mass>1200</Mass>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>RKU_DrillingVehicleWithTurret</defName>
    <thingClass>RatkinUnderground.RKU_DrillingVehicleWithTurret</thingClass>
    <tickerType>Normal</tickerType>
    <label>Armed Ratkin Drilling Vehicle</label>
    <description>Armed Ratkin Drilling Vehicle, This is no joke!</description>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <fillPercent>0.20</fillPercent>
    <pathCost>14</pathCost>
    <drawerType>RealtimeOnly</drawerType>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <size>(2,1)</size>
    <uiIconScale>1.4</uiIconScale>
	<building>
	    <turretTopOffset>(-0.27, 0.27)</turretTopOffset>
		<turretBurstWarmupTime>1.0</turretBurstWarmupTime>
		<turretBurstCooldownTime>1.0</turretBurstCooldownTime>
		<turretGunDef>RKU_TurretGun</turretGunDef>
		<expandHomeArea>false</expandHomeArea>
    </building>
	<designationCategory>Misc</designationCategory>
    <graphicData>
      <drawSize>(4.5,4.5)</drawSize>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Buildings/DrillingVehicle/DrillingVehicleTurret</texPath>
    </graphicData>
	<uiIconPath>Buildings/DrillingVehicle/DrillingVehicleTurret</uiIconPath>
    <costList>
	   <Steel>100</Steel>
       <ComponentIndustrial>25</ComponentIndustrial>
       <Chemfuel>50</Chemfuel>
	     <RKU_GlowstonePowder>50</RKU_GlowstonePowder>
    </costList>
	 <researchPrerequisites>
      <li>RKU_UndergroundExperimentalWeapon</li>
    </researchPrerequisites>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
  </ThingDef>
  
   <ThingDef ParentName="BaseWeaponTurret">
    <defName>RKU_TurretGun</defName>
    <label>Ratkin Underground Turret Gun</label>
    <description>Ratkin Underground Turret Gun</description>
    <graphicData>
      <texPath>Buildings/DrillingVehicle/Turret/TurretGun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.28</AccuracyTouch>
      <AccuracyShort>0.72</AccuracyShort>
      <AccuracyMedium>0.66</AccuracyMedium>
      <AccuracyLong>0.5</AccuracyLong>
      <RangedWeapon_Cooldown>0.02</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>40</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>Bullet_AutocannonTurret</defaultProjectile>
        <warmupTime>0.02</warmupTime>
        <range>32.9</range>
        <ticksBetweenBurstShots>0</ticksBetweenBurstShots>
        <burstShotCount>3</burstShotCount>
        <soundCast>Shot_Autocannon</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>15</muzzleFlashScale>
        <consumeFuelPerShot>1</consumeFuelPerShot>
      </li>
    </verbs>
  </ThingDef>
  
   <ThingDef ParentName="EtherealThingBase">
    <defName>RKU_TunnelHiveSpawner</defName>
    <label>Tunnel</label>
    <thingClass>RatkinUnderground.RKU_TunnelHiveSpawner</thingClass>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <alwaysFlee>true</alwaysFlee>
    <building>
      <groundSpawnerSustainedEffecter>EmergencePointSustained2X2</groundSpawnerSustainedEffecter>
      <groundSpawnerCompleteEffecter>EmergencePointComplete2X2</groundSpawnerCompleteEffecter>
    </building>
  </ThingDef>
  
  <ThingDef ParentName="BuildingBase">
    <defName>RKU_DrillingVehicleInEnemyMap</defName>
    <label>Drilling Vehicle</label>
    <description>Drilling Vehicle, you need to get back in this car to leave the map.</description>
	<thingClass>RatkinUnderground.RKU_DrillingVehicleInEnemyMap</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <selectable>true</selectable>
    <fillPercent>0.20</fillPercent>
    <pathCost>200</pathCost>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <rotatable>false</rotatable>
	<size>(2,1)</size>
    <graphicData>
      <drawSize>(4.5,4.5)</drawSize>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Buildings/InMap/RK_GuerrillaTunnel</texPath>
    </graphicData>
    <statBases>
	  <Mass>1000</Mass>
      <MaxHitPoints>500</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
  </ThingDef>

  <!-- 钻地机冲刺投射物 -->
  <ThingDef ParentName="BaseBullet">
    <defName>RKU_DrillingVehicleBullet</defName>
    <label>Drilling Vehicle Projectile</label>
    <thingClass>RatkinUnderground.RKU_DrilingBullet</thingClass>
    <graphicData>
      <texPath>Buildings/DrillingVehicle/BaseDrillingVehicleBullet/BaseDrillingVehicleBullet</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>4.3</drawSize>
    </graphicData>
    <projectile>
      <speed>6</speed>
      <arcHeightFactor>0</arcHeightFactor>
      <shadowSize>1</shadowSize>
    </projectile>
  </ThingDef>
  
  <WorldObjectDef>
    <defName>TravelingDrillingVehicle</defName>
    <label>Drilling Vehicle Squad</label>
    <description>A submersible transport drilling vehicle and its crew.</description>
    <worldObjectClass>RatkinUnderground.RKU_DrillingVehicleOnMap</worldObjectClass>
    <texture>World/WorldObjects/Caravan</texture>
    <useDynamicDrawer>true</useDynamicDrawer>
    <expandingIcon>true</expandingIcon>
	  <rotateGraphicWhenTraveling>true</rotateGraphicWhenTraveling>
    <expandingIconTexture>Buildings/InWorld/BaseDrillingVehicle</expandingIconTexture>
    <expandingIconPriority>100</expandingIconPriority>
    <expandMore>true</expandMore>
    <allowCaravanIncidentsWhichGenerateMap>true</allowCaravanIncidentsWhichGenerateMap>
    <IncidentTargetTags>
      <li>Caravan</li>
    </IncidentTargetTags>
    <inspectorTabs>
      <li>WITab_Caravan_Health</li>
      <li>WITab_Caravan_Needs</li>
      <li>WITab_Caravan_Gear</li>
      <li>WITab_Caravan_Social</li>
      <li>WITab_Caravan_Items</li>
      <li>WITab_Caravan_Feeding</li>
    </inspectorTabs>
  </WorldObjectDef>
  
  <!-- 地鼠派系特殊建筑 -->
  
