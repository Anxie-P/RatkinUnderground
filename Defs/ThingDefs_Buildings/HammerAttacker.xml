<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BuildingBase">
        <!-- 地锤装置 -->
        <defName>RKU_HammerAttacker</defName>
        <thingClass>RatkinUnderground.RKU_HammerAttacker</thingClass>
        <tickerType>Normal</tickerType>
        <label>Hammer Attacker</label> 
        <description>地锤装置，地鼠游击队的终极武器，通过巨大的钢芯震击地下岩层以唤醒地下沉睡的怪物们......破坏它可以严重打击敌人的士气。</description>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <rotatable>false</rotatable>
        <selectable>true</selectable>
        <category>Building</category>
        <fillPercent>0.20</fillPercent>
        <pathCost>8</pathCost>
		<researchPrerequisites>
			<li>RKU_UndergroundExperimentalWeapon</li>
        </researchPrerequisites>
	    <designationCategory>Security</designationCategory>
        <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
        <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
        <size>(4,4)</size>
        <graphicData>
			<drawSize>(6.5,6.5)</drawSize>
			<graphicClass>Graphic_Single</graphicClass>
			<texPath>Buildings/Hammer/HammerAttackerG</texPath>
			<shaderType>Cutout</shaderType>
        </graphicData>
        <costList>
            <Steel>100</Steel>
        </costList>
        <statBases>
            <MaxHitPoints>1000</MaxHitPoints>
            <Flammability>0</Flammability>
        </statBases>
        <comps>
            <li Class="CompProperties_Forbiddable" />
        </comps>
    </ThingDef>

</Defs>