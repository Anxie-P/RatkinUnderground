			<li>RKU_Apparel_CaptainUniform</li>
			<li>RKU_Apparel_CaptainHat</li>
			<li>RKU_Apparel_CaptainCloak</li>
		</apparelRequired>
		<apparelMoney>
			<min>1500</min>
			<max>2000</max>
		</apparelMoney>
		<weaponMoney>
			<min>2500</min>
			<max>4000</max>
