<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef Name="RKU_BestHelmetBase" Abstract="True" ParentName="ApparelBase">
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<tradeability>None</tradeability>
		<uiIconScale>1.3</uiIconScale>
		<smeltable>false</smeltable>
		<thingCategories Inherit="False">
			<li>Apparel</li>
		</thingCategories>
		<statBases>
			<EquipDelay>1</EquipDelay>
		</statBases>
		<apparel>
			<layers>
				<li>Overhead</li>
			</layers>
		</apparel>
		<tradeTags>
			<li>RKU_GuerrillasArmorTag</li>
		</tradeTags>
		<generateAllowChance>0.1</generateAllowChance>
		<generateCommonality>0.1</generateCommonality>
		<recipeMaker IsNull="True"/>
	</ThingDef>
	
	<!-- 矿工头盔 -->
	<ThingDef Class="NewRatkin.CustomThingDef" ParentName="RK_HatMakeableBase">
		<defName>RKU_MinerHelmet</defName>
		<label>地鼠矿工盔</label>
		<description>地下工作用的矿工头盔，附带有一个简易过滤器，地下工作的优选。</description>
		<graphicData>
			<texPath>Things/Item/Armors/helm/MinerHelmet</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<costList>
			<Steel>25</Steel>
		</costList>
		<costStuffCount>40</costStuffCount>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<WorkToMake>18000</WorkToMake>
			<Mass>3</Mass>			
			<StuffEffectMultiplierArmor>0.35</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.0</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.0</StuffEffectMultiplierInsulation_Heat>			
			<ArmorRating_Sharp>0.40</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.20</ArmorRating_Blunt>
			<EquipDelay>1.5</EquipDelay>
		</statBases>
		<apparel>
			<bodyPartGroups>
				<li>FullHead</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Item/Armors/helm/MinerHelmet</wornGraphicPath>
			<tags>
				<li>RKU_Miner</li>
				<li>RKU_Invader</li>
			</tags>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
			<layers>
				<li>Overhead</li>
			</layers>
		</apparel>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
			<researchPrerequisite>HighClassClothing</researchPrerequisite>
			<recipeUsers Inherit="false">
				<li>RK_FueledSmithy</li>
				<li>RK_ElectricSmithy</li>
			</recipeUsers>
			<defaultIngredientFilter>
				<disallowedThingDefs>
					<li>Gold</li>
					<li>Silver</li>
				</disallowedThingDefs>
			</defaultIngredientFilter>		
		</recipeMaker>
		<followStuffColor>false</followStuffColor>
	</ThingDef>

	<ThingDef ParentName="RKU_BestHelmetBase">
		<defName>RKU_Apparel_ScoutHat</defName>
		<label>游击队侦察兵帽子</label>
		<description>侦察兵常戴的帽子，方便行动且便于隐蔽。</description>
		<recipeMaker>
			<researchPrerequisite>RKU_UndergroundGuerrillaEquipments</researchPrerequisite>
			<skillRequirements>
				<Crafting>4</Crafting>
			</skillRequirements>
			<workSkill>Crafting</workSkill>
			<effectWorking>Smith</effectWorking>
			<soundWorking>Recipe_Smith</soundWorking>
			<recipeUsers>
				<li>RK_FueledSmithy</li>
				<li>RK_ElectricSmithy</li>
			</recipeUsers>
			<unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
		</recipeMaker>
		<costList>
			<Cloth>30</Cloth>
			<Steel>5</Steel>
		</costList>
		<graphicData>
			<texPath>Things/Item/Armors/Scout/Hat/RatkinScout_Helmet</texPath>
		</graphicData>
		<statBases>
			<MarketValue>100</MarketValue>
			<MaxHitPoints>400</MaxHitPoints>
			<WorkToMake>700</WorkToMake>
			<Mass>2</Mass>			
			<StuffEffectMultiplierArmor>0.35</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.7</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.5</StuffEffectMultiplierInsulation_Heat>			
			<ArmorRating_Sharp>0.35</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.5</ArmorRating_Blunt>
			<ArmorRating_Heat>0.3</ArmorRating_Heat>
			<Insulation_Cold>16</Insulation_Cold>
			<Insulation_Heat>13</Insulation_Heat>
			<EquipDelay>1.5</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<MoveSpeed>+1</MoveSpeed>
		</equippedStatOffsets>
		<generateCommonality>0.1</generateCommonality>
		<apparel>
			<bodyPartGroups>
				<li>FullHead</li>
			</bodyPartGroups>
			<tags>
				<li>RKU_Scout</li>
			</tags>
			<wornGraphicPath>Things/Item/Armors/Scout/Hat/RatkinScout_Helmet</wornGraphicPath>
		</apparel>
	</ThingDef>
	
	<ThingDef ParentName="RKU_BestHelmetBase">
