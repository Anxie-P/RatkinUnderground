   <!--电台背包-->
  <ThingDef ParentName="RKU_ArmorBase">
    <defName>RKU_Apparel_InvaderBag</defName>
    <label>电台背包</label>
    <description>一个便携式电台，用于与地鼠指挥部通讯，也可以呼叫钻地袭击。</description>
    <recipeMaker>
      <researchPrerequisite>RKU_UndergroundExperimentalWeapon</researchPrerequisite>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <recipeUsers>
        <li>ElectricSmithy</li>
        <li>FueledSmithy</li>
      </recipeUsers>
      <unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
    </recipeMaker>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>25</ComponentIndustrial>
    </costList>
    <graphicData>
      <texPath>Things/Item/Armors/Invader/Uniform_Elite/InvaderBag</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>280</MaxHitPoints>
      <WorkToMake>3500</WorkToMake>
      <Mass>3</Mass>
      <EquipDelay>2</EquipDelay>
	  <MarketValue>1300</MarketValue>
