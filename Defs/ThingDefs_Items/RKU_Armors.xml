<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 堆叠 -->
  <ThingCategoryDef>
    <defName>RKU_Category_Apparel</defName>
    <label>RKU-Apparel</label>
    <parent>Apparel</parent>
  </ThingCategoryDef>

  <!-- 父类 -->
  <ThingDef Name="RKU_ArmorBase" Abstract="True" ParentName="ApparelBase">
    <smeltable>false</smeltable>
    <tradeability>None</tradeability>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.00</drawSize>
    </graphicData>
    <thingCategories Inherit="False">
      <li>RKU_Category_Apparel</li>
    </thingCategories>
    <apparel>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <tradeTags>
      <li>RKU_GuerrillasArmorTag</li>
    </tradeTags>
    <recipeMaker IsNull="True"/>
    <generateAllowChance>0.1</generateAllowChance>
    <generateCommonality>0.1</generateCommonality>
  </ThingDef>
  
  <!--游击队侦察兵制服-->
  <ThingDef ParentName="RKU_ArmorBase">
    <defName>RKU_Apparel_ScoutUniform</defName>
    <label>游击队侦察兵制服</label>
    <description>游击队侦察兵的制服，材质粗糙但非常轻便。很可惜他们并没有闲暇打棒球</description>
    <recipeMaker>
      <researchPrerequisite>RKU_UndergroundGuerrillaEquipments</researchPrerequisite>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <recipeUsers>
        <li>ElectricSmithy</li>
        <li>FueledSmithy</li>
      </recipeUsers>
      <unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
    </recipeMaker>
    <costList>
      <Cloth>60</Cloth>
      <Steel>20</Steel>
    </costList>
    <graphicData>
      <texPath>Things/Item/Armors/Scout/Uniform/RatkinScout</texPath>
    </graphicData>
    <statBases>
      <MarketValue>200</MarketValue>
      <MaxHitPoints>540</MaxHitPoints>
      <WorkToMake>4000</WorkToMake>
      <Mass>1</Mass>
      <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>2.45</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>4.45</StuffEffectMultiplierInsulation_Heat>
      <ArmorRating_Sharp>0.65</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
      <ArmorRating_Heat>0.65</ArmorRating_Heat>
      <Insulation_Cold>26</Insulation_Cold>
      <Insulation_Heat>15</Insulation_Heat>
      <Flammability>0.0</Flammability>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>+0.5</MoveSpeed>
      <FilthRate>-0.8</FilthRate>
      <MeleeDodgeChance>0.2</MeleeDodgeChance>
      <PainShockThreshold>-0.2</PainShockThreshold>
      <CarryingCapacity>12</CarryingCapacity>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <wornGraphicPath>Things/Item/Armors/Scout/Uniform/RatkinScout</wornGraphicPath>
      <layers>
        <li>Shell</li>
        <li>BackPack</li>
      </layers>
    </apparel>
  </ThingDef>

  <!--游击队精英侦察兵制服-->
