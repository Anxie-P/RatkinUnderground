      <ArmorRating_Blunt>1</ArmorRating_Blunt>
      <ArmorRating_Heat>1</ArmorRating_Heat>
      <Flammability>0.0</Flammability>
    </statBases>
    <equippedStatOffsets>
      <CarryingCapacity>-15</CarryingCapacity>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Shoulders</li>
		<li>Torso</li>
        <li>Neck</li>
      </bodyPartGroups>
