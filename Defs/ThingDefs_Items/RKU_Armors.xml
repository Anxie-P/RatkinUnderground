      <li Class="RatkinUnderground.CompProperties_RKU_BackpackRadio">
        <turretRange>30</turretRange>
        <wallRange>30</wallRange>
		<bulletDef>RKU_BunkerBusterBullet</bulletDef>
      </li>
    </comps>
  </ThingDef>
